# Public — exposed to the browser bundle. Only set if you want to bypass the
# /api/proxy route and call the backend directly (typical: never).
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only — used by middleware.ts to gate every page + the proxy route.
# Browser-side user prompt validates against these (after b64 decode).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Server-only — used by app/api/proxy/[...path]/route.ts when injecting the
# Authorization header on calls to the FastAPI backend. Defaults to the same
# BASIC_AUTH_* pair above if these are unset, so most deploys only set one set.
BACKEND_AUTH_USER=
BACKEND_AUTH_PASS=

# Server-only — where /api/proxy forwards requests. Render URL in prod,
# localhost:8000 in dev.
BACKEND_URL=http://localhost:8000
