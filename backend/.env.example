ANTHROPIC_API_KEY=sk-ant-api03-key-here
# Metabase — required for the live-data refresh (Grip Connect).
# v1 uses email/password (session login). METABASE_API_KEY is reserved for the
# future service-account token; leave it unset for now.
METABASE_URL=https://metabase.gripinvest.in
METABASE_EMAIL=
METABASE_PASSWORD=
METABASE_API_KEY=
DATA_DIR=./data

# Basic-auth gate (BasicAuthMiddleware in middleware/basic_auth.py).
# When both are set, every /api/* request must carry an
#   Authorization: Basic base64("$USER:$PASS")
# header. /health and /ping bypass the gate so UptimeRobot keeps working.
# Leave unset locally for an open API.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
