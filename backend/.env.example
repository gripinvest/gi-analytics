ANTHROPIC_API_KEY=sk-ant-api03-key-here
METABASE_API_KEY=key-here
METABASE_URL=key-here
DATA_DIR=key-here

# Basic-auth gate (BasicAuthMiddleware in middleware/basic_auth.py).
# When both are set, every /api/* request must carry an
#   Authorization: Basic base64("$USER:$PASS")
# header. /health and /ping bypass the gate so UptimeRobot keeps working.
# Leave unset locally for an open API.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
